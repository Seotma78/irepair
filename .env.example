# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# JWT_SECRET: Secret key for signing admin authentication tokens (JWT).
# You can generate a cryptographically strong 64-character hex key in your terminal with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If omitted, a secure internal fallback is used automatically.
JWT_SECRET="replace-with-a-very-long-random-secret-for-jwt-signing"

# ENCRYPTION_KEY: Master key for AES-256-GCM encryption of WooCommerce credentials at rest.
# You can generate a 32-byte (64-character hex) key in your terminal with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If omitted, a secure deterministic machine seed is used automatically.
ENCRYPTION_KEY="replace-with-a-secure-32-byte-hex-or-passphrase-key"

# MAP_API_KEY: API key for map tile and geocoding services.
MAP_API_KEY="MY_MAP_API_KEY"
VITE_MAP_API_KEY="MY_MAP_API_KEY"

# WOOCOMMERCE INTEGRATION (Optional - encrypted DB credentials used if omitted)
# Store base URL (e.g. https://irepair-mobiles.co.uk or https://old.irepair-mobiles.co.uk at launch)
WOOCOMMERCE_URL="https://irepair-mobiles.co.uk"
# Read/Write Consumer Key for sync & order checkout
WOOCOMMERCE_KEY="ck_your_woocommerce_consumer_key"
# Consumer Secret
WOOCOMMERCE_SECRET="cs_your_woocommerce_consumer_secret"
# Webhook secret for HMAC-SHA256 signature verification on /api/webhooks/woocommerce
WOOCOMMERCE_WEBHOOK_SECRET="wc_webhook_secret_irepair_2026"
# Brand & Condition attribute slugs
WOOCOMMERCE_BRAND_TAXONOMY="pa_brand"
WOOCOMMERCE_CONDITION_TAXONOMY="pa_condition"

# WOOCOMMERCE HOSTED PAYMENT GATEWAY (STRIPE VIA WORDPRESS)
# When true (or in NODE_ENV=production), ALL checkout/express/order-pay flows go through WordPress + WooCommerce Stripe.
PAYMENTS_USE_WOO_HOSTED="true"
# Checkout handoff style: 'hosted_checkout' (Style 1: WooCommerce cart+checkout) or 'order_pay' (Style 2: React address + WC order-pay)
PAYMENTS_HANDOFF_STYLE="hosted_checkout"
# Hosted WordPress base URL (defaults to SEO WordPress source URL; change to e.g. https://old.irepair-mobiles.co.uk at launch)
WOO_HOSTED_BASE_URL="https://irepair-mobiles.co.uk"
# Shared HMAC-SHA256 secret matching WordPress 'iRepair Headless Checkout Bridge' plugin settings
PAYMENTS_HANDOFF_SECRET="replace-with-a-long-random-handoff-secret"
# Optional overrides for hosted checkout return/cancel URLs (defaults to APP_URL + /order-confirmation and /cart)
PAYMENTS_RETURN_URL=""
PAYMENTS_CANCEL_URL=""

# DEV/STAGING SIMULATED MODE ONLY (Unused and ignored when Hosted Gateway is ON or in Production)
# Stripe API keys live inside WordPress -> WooCommerce -> Settings -> Payments -> Stripe.
STRIPE_MODE="test"
STRIPE_TEST_PUBLISHABLE_KEY=""
STRIPE_TEST_SECRET_KEY=""
STRIPE_LIVE_PUBLISHABLE_KEY=""
STRIPE_LIVE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_APPLE_MERCHANT_ID="merchant.com.irepairmobiles.uk"
